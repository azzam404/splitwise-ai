NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/splitwise-ai
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Production only (see DEPLOY.md). Proxy hops in front of the API, and the auth cookie SameSite
# mode: keep "lax" when the client proxies /api; "none" only for a cross-site API URL.
# TRUST_PROXY=1
# COOKIE_SAME_SITE=lax

# Optional: enables AI quick-add, receipt scanning and insights (Claude Haiku 5.5).
# Create a key at https://console.anthropic.com (API billing is separate from Claude Pro).
# Without it, the AI features are switched off and everything else works normally.
ANTHROPIC_API_KEY=
